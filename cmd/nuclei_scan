#!/usr/bin/env bash
set -euo pipefail
IFS=$' \t\n'

# ---------------- FFUF & NUCLEI (sequential per host) ----------------
RUN_NUCLEI(){
  local HOST="$1"
  local HOST_SAFE
  HOST_SAFE=$(SAFE_NAME "$HOST")   # shared helper; was a per-host echo|sed
  local NUC_DIR="$OUTPUT_DIR/nuclei"
  mkdir -p "$NUC_DIR"

  # prepare nuclei targets file using host:port combos (http & https)
  NUC_TARGETS="$NUC_DIR/${HOST_SAFE}_targets.txt"
  # use ports file to generate host:port combos. One awk pass instead of
  # reopening the targets file twice per port.
  PORT_FILE="$OUTPUT_DIR/ports/${HOST_SAFE}_ports"
  if [[ -s "$PORT_FILE" ]]; then
    awk -v h="$HOST" 'NF { print "http://" h ":" $1; print "https://" h ":" $1 }' \
      "$PORT_FILE" > "$NUC_TARGETS"
  else
    printf 'http://%s\nhttps://%s\n' "$HOST" "$HOST" > "$NUC_TARGETS"
  fi

  if [[ -s "$NUC_TARGETS" ]]; then
    NUC_OUT="$NUC_DIR/${HOST_SAFE}.json"
    # -jsonl is the v3 flag (the installer pins nuclei/v3); v2 used -json.
    INFO "nuclei -> $HOST" && "$(command -v nuclei || echo "$BIN_DIR/nuclei")" -l "$NUC_TARGETS" -o "$NUC_OUT" -jsonl || true
  fi
}