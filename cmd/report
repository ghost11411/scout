.legend{font-size:12.5px;color:var(--muted);margin-top:8px;}
</style>
</head>
<body>
<div class="wrap">
HTML_HEAD

    # ---- Hero / metadata ----
    printf '<header class="hero"><h1>Scout Recon Report</h1>'
    printf '<div class="sub">Target: <strong>%s</strong></div>' "$(_ESC "$targets")"
    printf '<div class="meta">'
    printf '<div><span>Generated</span><br><strong>%s</strong></div>' "$(_ESC "$gen")"
    printf '<div><span>Total runtime</span><br><strong>%s</strong></div>' "$(_ESC "$total")"
    printf '<div><span>Safe mode</span><br><strong>%s</strong></div>' "$([[ "${SCOUT_SAFE:-1}" == "1" ]] && echo ON || echo OFF)"
    printf '<div><span>Findings</span><br><strong>%s</strong></div>' "$_SEV_TOTAL"
    printf '<div><span>Output dir</span><br><strong class="mono">%s</strong></div>' "$(_ESC "$O")"
    printf '</div></header>\n'

    # ---- Severity cards ----
    printf '<section class="panel"><h2>Vulnerability severity</h2>'
    if (( HAVE_NUCLEI )); then
      printf '<div class="cards">'
      printf '<div class="card crit"><div class="n">%s</div><div class="l">Critical</div></div>' "$_SEV_CRIT"
      printf '<div class="card high"><div class="n">%s</div><div class="l">High</div></div>' "$_SEV_HIGH"
      printf '<div class="card med"><div class="n">%s</div><div class="l">Medium</div></div>' "$_SEV_MED"
      printf '<div class="card low"><div class="n">%s</div><div class="l">Low</div></div>' "$_SEV_LOW"
      printf '<div class="card info"><div class="n">%s</div><div class="l">Info</div></div>' "$_SEV_INFO"
      printf '</div>'
      printf '<h3>Findings (most severe first)</h3><div class="tablewrap"><table>'
      printf '<tr><th>Severity</th><th>Name / template</th><th>Location</th></tr>'
      _FINDINGS_ROWS "${NUCLEI_FILES[@]}"
      printf '</table></div>'
    else
      printf '<p class="empty">No nuclei scan recorded (run with SCOUT_NUCLEI=1 or SCOUT_OWASP=1 to enable template-based vulnerability scanning).</p>'
    fi
    printf '</section>\n'

    # ---- Active exploitation findings (tool-confirmed, per class) ----
    # These come from the dedicated active stages (dalfox, qsreplace+httpx probes,
    # subzy). Each row carries the severity level typical of that class so the
    # report shows "severity found" for the non-nuclei findings too.
    _ACTIVE_ROW(){ # <severity> <class> <file>
      [[ -s "$3" ]] || return 0
      local c; c=$(COUNT_LINES "$3")
      (( c > 0 )) || return 0
      printf '<tr><td><span class="sev sev-%s">%s</span></td><td>%s</td><td class="num">%s</td><td class="mono">%s</td></tr>\n' \
        "$1" "$1" "$(_ESC "$2")" "$c" "$(_ESC "${3#"$O"/}")"
    }
    local _has_active=0
    for _af in "$O/vulns/xss.txt" "$O/vulns/lfi.txt" "$O/vulns/sqli.txt" "$O/vulns/open_redirect.txt" \
               "$O/vulns/ssrf_candidates.txt" "$O/vulns/rfi_candidates.txt" "$O/takeover/takeovers.txt"; do
      [[ -s "$_af" ]] && _has_active=1
    done
    if (( _has_active )); then
      printf '<section class="panel"><h2>Active exploitation findings</h2>'
      printf '<div class="tablewrap"><table><tr><th>Severity</th><th>Class</th><th>Count</th><th>File</th></tr>'
      _ACTIVE_ROW high     "Subdomain takeover (subzy)"    "$O/takeover/takeovers.txt"
      _ACTIVE_ROW high     "Cross-site scripting (dalfox)" "$O/vulns/xss.txt"
      _ACTIVE_ROW high     "Local file inclusion"          "$O/vulns/lfi.txt"
      _ACTIVE_ROW critical "SQL injection (error-based)"   "$O/vulns/sqli.txt"
      _ACTIVE_ROW medium   "Open redirect"                 "$O/vulns/open_redirect.txt"
      _ACTIVE_ROW low      "SSRF candidates (review)"      "$O/vulns/ssrf_candidates.txt"
      _ACTIVE_ROW low      "RFI candidates (review)"       "$O/vulns/rfi_candidates.txt"
      printf '</table></div>'
      printf '<p class="legend">Candidate rows are leads to verify by hand; confirmed rows were matched by the tool. Severity shown is the class-typical rating, not a per-instance CVSS.</p></section>\n'
    fi

    # ---- Phase timeline ----
    printf '<section class="panel"><h2>Bug-bounty phases</h2>'
    printf '<div class="tablewrap"><table><tr><th>#</th><th>Phase</th><th>Wall time</th><th>Tools</th><th>Items</th></tr>'
    if [[ -s "$PHASES_TSV" ]]; then
      # For each phase (in execution order), sum tool runs + items from tools.tsv.
      awk -F'\t' -v OFS='\t' '
        FNR==NR { # tools.tsv: phase,tool,secs,count,cmd
          runs[$1]++; items[$1]+=$4; next
        }
        { # phases.tsv: phase,secs
          n++; print n, $1, $2, (runs[$1]+0), (items[$1]+0)
        }' "$TOOLS_TSV" "$PHASES_TSV" 2>/dev/null |
      while IFS=$'\t' read -r idx phase secs pruns pitems; do
        printf '<tr><td class="num">%s</td><td><span class="phase-tag">%s</span></td><td class="time">%s</td><td class="num">%s</td><td class="num">%s</td></tr>\n' \
          "$idx" "$(_ESC "$phase")" "$(HUMAN_TIME "$secs")" "$pruns" "$pitems"
      done
    else
      printf '<tr><td colspan="5" class="empty">No phase timing recorded.</td></tr>'
    fi
    printf '</table></div><p class="legend">Wall time is measured per phase; Items is the total produced by the tools in that phase.</p></section>\n'

    # ---- Tools & commands, grouped by phase ----
    printf '<section class="panel"><h2>Tools &amp; commands per phase</h2>'
    if [[ -s "$TOOLS_TSV" ]]; then
      printf '<div class="tablewrap"><table><tr><th>Phase</th><th>Tool</th><th>Runs</th><th>Time</th><th>Items</th><th>Command</th></tr>'
      # Aggregate per (phase,tool): sum secs, sum count, count runs, first cmd;
      # preserve first-seen order of phase then tool.
      awk -F'\t' '
        {
          key=$1 SUBSEP $2
          if (!(key in seen)) { seen[key]=1; order[++n]=key; cmd[key]=$5; ph[key]=$1; tl[key]=$2 }
          secs[key]+=$3; items[key]+=$4; runs[key]++
        }
        END{
          for (i=1;i<=n;i++){ k=order[i];
            printf "%s\t%s\t%s\t%s\t%s\t%s\n", ph[k], tl[k], runs[k], secs[k], items[k], cmd[k] }
        }' "$TOOLS_TSV" 2>/dev/null |
      while IFS=$'\t' read -r phase tool runs secs items cmd; do
        printf '<tr><td><span class="phase-tag">%s</span></td><td>%s</td><td class="num">%s</td><td class="time">%s</td><td class="num">%s</td><td class="mono">%s</td></tr>\n' \
          "$(_ESC "$phase")" "$(_ESC "$tool")" "$runs" "$(HUMAN_TIME "$secs")" "$items" "$(_ESC "$cmd")"
      done
      printf '</table></div>'
    else
      printf '<p class="empty">No per-tool telemetry recorded.</p>'
    fi
    printf '</section>\n'

    # ---- Assets ----
    printf '<section class="panel"><h2>Assets discovered</h2><div class="tablewrap"><table>'
    printf '<tr><th>Stage</th><th>Count</th><th>File</th></tr>'
    _ASSET_ROW "Combined subdomains" "$O/subdomains/combined_subdomains.txt"
    _ASSET_ROW "Resolved (final)"    "$O/final_subdomains.out"
    _ASSET_ROW "Live web hosts"      "$O/http/live_hosts.txt"
    _ASSET_ROW "URLs collected"      "$O/urls/all_urls.out"
    _ASSET_ROW "Parameter keys"      "$O/urls/param_keys.txt"
    _ASSET_ROW "JS files"            "$O/js/all_js_files.out"
    _ASSET_ROW "JS endpoints"        "$O/js/js_endpoints.txt"
    _ASSET_ROW "JS secrets (records)" "$O/js/js_secrets.jsonl"
    _ASSET_ROW "Parameterized URLs (corpus)" "$O/params/param_urls.txt"
    _ASSET_ROW "Hidden params (arjun)" "$O/params/arjun_params.txt"
    _ASSET_ROW "Favicon hashes" "$O/favicon/favicon_hashes.txt"
    _ASSET_ROW "GitHub dork hits" "$O/github/gitdorks.txt"
    _ASSET_ROW "Subdomain takeovers" "$O/takeover/takeovers.txt"
    printf '</table></div>'

    # gf buckets
    if compgen -G "$O/urls/gf/*.txt" > /dev/null 2>&1; then
      printf '<h3>URL vuln-candidate buckets (gf)</h3><div class="tablewrap"><table>'
      printf '<tr><th>Class</th><th>URLs</th><th>File</th></tr>'
      local f
      for f in "$O"/urls/gf/*.txt; do
        printf '<tr><td>%s</td><td class="num">%s</td><td class="mono">%s</td></tr>\n' \
          "$(_ESC "$(basename "$f" .txt)")" "$(COUNT_LINES "$f")" "$(_ESC "${f#"$O"/}")"
      done
      printf '</table></div>'
    fi

    # active-stage artifacts
    local have_active=0
    { compgen -G "$O/ports/*_ports" >/dev/null 2>&1 || [[ -d "$O/content" || -d "$O/screenshots" ]]; } && have_active=1
    if (( have_active )); then
      printf '<h3>Active-stage outputs</h3><div class="tablewrap"><table><tr><th>Item</th><th>Count</th></tr>'
      if compgen -G "$O/ports/*_ports" >/dev/null 2>&1; then
        printf '<tr><td>Hosts with open ports</td><td class="num">%s</td></tr>' \
          "$(find "$O/ports" -name '*_ports' -size +0c 2>/dev/null | wc -l | tr -d ' ')"
      fi
      [[ -d "$O/content" ]]     && printf '<tr><td>Content-discovery outputs</td><td class="num">%s</td></tr>' "$(find "$O/content" -type f 2>/dev/null | wc -l | tr -d ' ')"
      [[ -d "$O/screenshots" ]] && printf '<tr><td>Screenshots</td><td class="num">%s</td></tr>' "$(find "$O/screenshots" -name '*.png' 2>/dev/null | wc -l | tr -d ' ')"
      printf '</table></div>'
    fi

    # scope leads
    if [[ -s "$O/scope_expansion/asn_cidrs.txt" || -s "$O/scope_expansion/related_domains.txt" ]]; then
      printf '<h3>Scope-expansion leads (review only — not scanned)</h3><div class="tablewrap"><table>'
      printf '<tr><th>Lead</th><th>Count</th><th>File</th></tr>'
      _ASSET_ROW "ASN / CIDR ranges"    "$O/scope_expansion/asn_cidrs.txt"
      _ASSET_ROW "Related root domains" "$O/scope_expansion/related_domains.txt"
      printf '</table></div><p class="legend">Confirm each is in your program scope before testing it.</p>'
    fi
    printf '</section>\n'

    printf '<footer>Generated by Scout — recon automation. Stay in scope; respect program rules and rate limits.<br>User-Agent: <span class="mono">%s</span></footer>\n' "$(_ESC "${SCOUT_UA:-unset}")"
    printf '</div></body></html>\n'
  } > "$HTML"

  OK "HTML report -> $HTML"
  return 0
}
