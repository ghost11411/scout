#!/usr/bin/env bash
set -euo pipefail
IFS=$' \t\n'

# ---------------- SUBDOMAIN COLLECTION ----------------
# Each tool below hits an independent, unrelated data source, so they're
# launched together and waited on once instead of running one at a time.
# Previously this stage's wall-clock time was the SUM of every tool's
# runtime; now it's roughly the slowest single tool's runtime.

_SUBFINDER()     { "$BIN_DIR/subfinder" -d "$DOMAIN" -all -silent > "$DOMAIN_OUTPUT_DIR/subfinder.out" 2>/dev/null || true; }
_ASSETFINDER()   { echo "$DOMAIN" | "$BIN_DIR/assetfinder" -subs-only 2>/dev/null | sort -u > "$DOMAIN_OUTPUT_DIR/assetfinder.out" || true; }
_FINDOMAIN()     { "$BIN_DIR/findomain" -t "$DOMAIN" --quiet > "$DOMAIN_OUTPUT_DIR/findomain.out" 2>/dev/null || true; }
_SUBDOG()        { echo "$DOMAIN" | "$BIN_DIR/subdog" --silent 2>/dev/null | sort -u > "$DOMAIN_OUTPUT_DIR/subdog.out" || true; }
_XSUBFIND3R()    { "$BIN_DIR/xsubfind3r" -d "$DOMAIN" -s > "$DOMAIN_OUTPUT_DIR/xsubfind3r.out" 2>/dev/null || true; }
_CERO()          { "$BIN_DIR/cero" -d "$DOMAIN" 2>/dev/null | sort -u > "$DOMAIN_OUTPUT_DIR/cero.out" || true; }
_SUBLIST3R()     { python3 "$BIN_DIR/sublist3r/sublist3r.py" -d "$DOMAIN" -o "$DOMAIN_OUTPUT_DIR/sublister.out" > /dev/null 2>&1 || true; }
_SUBDOMINATOR()  { subdominator -all -d "$DOMAIN" -s -o "$DOMAIN_OUTPUT_DIR/subdominator.out" > /dev/null 2>&1 || true; }
_CRTSH() {
  curl -sk --max-time 30 "https://crt.sh/?q=$DOMAIN&output=json" |
    tr ',' '\n' |
    awk -F'"' '/name_value/ {gsub(/\*\./, "", $4); gsub(/\\n/,"\n",$4); print $4}' |
    sort -u > "$DOMAIN_OUTPUT_DIR/crt.out" || true
}

COLLECT_SUBDOMAINS(){
  # Tool name -> the function that runs it. Driving the launch loop from this
  # table keeps the tool list, the launch order, and the per-tool result
  # counts below from drifting apart the way three hand-written lists would.
  local -A RUNNERS=(
    [subfinder]=_SUBFINDER   [assetfinder]=_ASSETFINDER   [findomain]=_FINDOMAIN
    [subdog]=_SUBDOG         [xsubfind3r]=_XSUBFIND3R     [cero]=_CERO
    [crt]=_CRTSH             [sublister]=_SUBLIST3R       [subdominator]=_SUBDOMINATOR
  )
  local TOOLS=(subfinder assetfinder findomain subdog xsubfind3r cero crt sublister subdominator)
  local PIDS=() T PID COUNT

  for T in "${TOOLS[@]}"; do
    "${RUNNERS[$T]}" &
    PIDS+=("$!")
  done

  START_SPINNER "Running ${#TOOLS[@]} subdomain enumeration tools in parallel on $DOMAIN"
  for PID in "${PIDS[@]}"; do
    wait "$PID" || true
  done
  STOP_SPINNER

  for T in "${TOOLS[@]}"; do
    OK "$T found: $(COUNT_LINES "$DOMAIN_OUTPUT_DIR/${T}.out") subdomains"
  done

  # after all tools finished, combine into a single deduped file.
  # One `cat` over the glob instead of a fork per file, and one pass into
  # sort instead of writing the concatenation out and re-sorting it in place.
  START_SPINNER "Combining all subdomain results"
  ALL_SUBS_FILE="$DOMAIN_OUTPUT_DIR/all_subdomains.txt"
  cat "$DOMAIN_OUTPUT_DIR"/*.out 2>/dev/null | sort -u > "$ALL_SUBS_FILE" || true
  STOP_SPINNER
  COUNT=$(COUNT_LINES "$ALL_SUBS_FILE")
  INFO "Subdomains found for $DOMAIN: $COUNT subdomains"
  INFO "Collected all subdomains -> $ALL_SUBS_FILE"
}
